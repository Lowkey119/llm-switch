<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- macOS 15+ 本地网络隐私：不声明该键的 app 连局域网地址会被静默拒绝
	     （connect 直接报错、不发 SYN，且系统不弹授权框）。本 app 的引擎探活与
	     转发目标（如 http://10.0.0.102:8731）都在局域网，必须声明，否则
	     打包版在装机机器上永远连不上引擎。 -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>llm-switch 需要访问局域网内的推理引擎后端，用于探活、模型扫描与请求转发。</string>
	<!-- 遥控器页 BLE（计划 2026-11-19 §八）：不声明该键，CoreBluetooth 首次扫描直接静默失败。 -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>llm-switch 需要蓝牙连接小米蓝牙遥控器，用于按键遥控与语音输入。</string>
	<!-- 语音路 1（系统转写）：Speech 框架与麦克风两路 TCC 用途描述。 -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>语音遥控器的「系统转写」模式需要语音识别，把你按语音键时说的话转成文字。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>语音遥控器的「系统转写」模式需要使用麦克风采集你说的话。</string>
</dict>
</plist>
